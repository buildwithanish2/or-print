<Window x:Class="PrintQRAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AnishNova Print Agent — Windows Desktop Spooler" 
        Height="740" Width="1060" 
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#080c14" Foreground="#f8fafc"
        FontFamily="Segoe UI, -apple-system, Arial"
        Icon="assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Primary Action Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#7c3aed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" 
                                                CornerRadius="10" 
                                                Background="#0f172a" 
                                                BorderBrush="#334155" 
                                                BorderThickness="1">
                                            <Grid HorizontalAlignment="Right" Margin="0,0,12,0">
                                                <Path x:Name="Arrow" 
                                                      Fill="#94a3b8" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#7c3aed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,8,28,8"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#0f172a" 
                                            BorderThickness="1" 
                                            BorderBrush="#7c3aed"
                                            CornerRadius="10"
                                            Margin="0,4,0,4">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#7c3aed"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#6d28d9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Live Health Telemetry -->
        <Border Grid.Row="0" Background="#0f172a" CornerRadius="16" Padding="18" Margin="0,0,0,16" BorderBrush="#1e293b" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" Background="#7c3aed" CornerRadius="14" Margin="0,0,14,0">
                        <Image Source="assets/app.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AnishNova " FontSize="21" FontWeight="Black" Foreground="#ffffff"/>
                            <TextBlock Text="Print Agent" FontSize="21" FontWeight="Bold" Foreground="#c084fc"/>
                        </StackPanel>
                        <TextBlock Text="Windows Desktop Spooler Daemon · v1.0.2 · AnishNova Technologies" FontSize="11" Foreground="#94a3b8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Real Health Telemetry Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadgeBorder" Background="#064e3b" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#10b981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="● ONLINE &amp; ACTIVE" FontWeight="Bold" Foreground="#34d399" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Shop Configuration, Discovered Printers & Updates -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Shop Pairing Card (Masked Pairing Key) -->
            <Border Grid.Column="0" Background="#0f172a" CornerRadius="16" Padding="18" BorderBrush="#1e293b" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Shop Pairing &amp; Identity" FontSize="14" FontWeight="Bold" Foreground="#e2e8f0" Margin="0,0,0,4"/>
                    <TextBlock Text="Enter temporary Pairing Code from your Shop Dashboard:" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Masked Password/Code Box (Hidden by default) -->
                        <PasswordBox x:Name="PairingCodePasswordBox" Background="#080c14" Foreground="#ffffff" 
                                     BorderBrush="#334155" Padding="12,10" FontSize="14" PasswordChar="●" 
                                     PasswordChanged="PairingCodePasswordBox_PasswordChanged"/>
                        
                        <!-- Plain text box when unmasked -->
                        <TextBox x:Name="PairingCodeTextBox" Visibility="Collapsed" Background="#080c14" Foreground="#ffffff" 
                                 BorderBrush="#334155" Padding="12,10" FontSize="14" FontWeight="Bold"
                                 TextChanged="PairingCodeTextBox_TextChanged"/>

                        <Button x:Name="ToggleMaskBtn" Grid.Column="1" Content="👁" Margin="6,0,0,0" Width="40" 
                                Click="ToggleMaskBtn_Click" Background="#1e293b" ToolTip="Toggle Key Masking"/>

                        <Button x:Name="PairButton" Grid.Column="2" Content="Activate Agent" Margin="8,0,0,0" 
                                Click="PairButton_Click" Background="#7c3aed" Padding="16,10"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="ShopInfoText" Text="Status: Waiting for shop activation..." FontSize="12" FontWeight="SemiBold" Foreground="#c084fc"/>
                    </StackPanel>

                    <!-- Telemetry Checks -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="HealthApiText" Text="API: ✓" FontSize="11" Foreground="#10b981" Margin="0,0,12,0"/>
                        <TextBlock x:Name="HealthWsText" Text="Job queue: ✓" FontSize="11" Foreground="#10b981" Margin="0,0,12,0"/>
                        <TextBlock x:Name="HealthSpoolerText" Text="Spooler: ✓" FontSize="11" Foreground="#10b981" Margin="0,0,12,0"/>
                        <TextBlock x:Name="HealthHeartbeatText" Text="Heartbeat: ✓" FontSize="11" Foreground="#10b981"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Discovered Windows Printers & Updates Card -->
            <Border Grid.Column="2" Background="#0f172a" CornerRadius="16" Padding="18" BorderBrush="#1e293b" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Discovered Windows Printers" FontSize="14" FontWeight="Bold" Foreground="#e2e8f0"/>
                        <!-- Update status indicator badge -->
                        <TextBlock x:Name="VersionBadgeText" Grid.Column="1" Text="v1.0.2 (Latest)" FontSize="11" FontWeight="SemiBold" Foreground="#a855f7"/>
                    </Grid>

                    <TextBlock Text="Select target Windows print spooler destination:" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PrintersComboBox" 
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="PrintersComboBox_SelectionChanged"/>
                        <Button x:Name="RescanBtn" Grid.Column="1" Content="↻ Rescan Printers" Margin="8,0,0,0" Click="RefreshPrinters_Click" Background="#334155" Padding="14,10"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PrinterCapabilitiesText" Text="Selected: HP LaserJet Pro (Default) • Ready for Spooling" FontSize="11" Foreground="#10b981" VerticalAlignment="Center"/>
                        <Button x:Name="CheckUpdateBtn" Grid.Column="1" Content="🔄 Check Updates" Background="#1e293b" Padding="10,4" FontSize="11" Click="CheckUpdateBtn_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Live Spooler Queue DataGrid -->
        <Border Grid.Row="2" Background="#0f172a" CornerRadius="16" Padding="18" BorderBrush="#1e293b" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Live Print Spooler Queue" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                    <TextBlock x:Name="QueueCountText" Grid.Column="1" Text="Queue: 0 Jobs" FontSize="12" Foreground="#94a3b8"/>
                </Grid>

                <DataGrid x:Name="QueueDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                          Background="Transparent" BorderThickness="0" 
                          RowBackground="#080c14" AlternatingRowBackground="#0f172a"
                          Foreground="#f8fafc" GridLinesVisibility="None" HeadersVisibility="Column"
                          IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1e293b"/>
                            <Setter Property="Foreground" Value="#94a3b8"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="6"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="140"/>
                        <DataGridTextColumn Header="Document" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="150"/>
                        <DataGridTextColumn Header="Copies" Binding="{Binding Settings.Copies}" Width="70"/>
                        <DataGridTextColumn Header="Color" Binding="{Binding Settings.ColorMode}" Width="70"/>
                        <DataGridTextColumn Header="Duplex" Binding="{Binding Settings.DuplexMode}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 4. Action Buttons Toolbar -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="📄 Diagnostic Test Print" Background="#10b981" Click="TestPrint_Click" Margin="0,0,10,0"/>
                <Button Content="🏪 Open Shop Dashboard" Background="#6366f1" Click="OpenDashboard_Click" Margin="0,0,10,0"/>
                <Button Content="📋 View Logs" Background="#334155" Click="ViewLogs_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="⬇ Hide to Tray" Background="#334155" Click="MinimizeToTray_Click" Margin="0,0,10,0"/>
                <Button Content="✕ Exit Agent" Background="#ef4444" Click="Exit_Click"/>
            </StackPanel>
        </Grid>

        <!-- 5. Footer Attribution -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="AnishNova Print • Developed by AnishNova Technologies • Enterprise Infrastructure" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
