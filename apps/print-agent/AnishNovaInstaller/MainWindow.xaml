<Window x:Class="AnishNovaInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnishNova Print Agent Setup Wizard" 
        Height="480" Width="600" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="assets/app.ico"
        Background="#0b0f19" Foreground="#f8fafc"
        FontFamily="Segoe UI, Plus Jakarta Sans, Arial">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#131b2e" CornerRadius="14" Padding="18" Margin="0,0,0,18" BorderBrush="#1e293b" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" Background="#7c3aed" CornerRadius="12" Margin="0,0,14,0">
                    <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AnishNova " FontSize="18" FontWeight="Black" Foreground="#ffffff"/>
                        <TextBlock Text="Print Agent Setup" FontSize="18" FontWeight="Bold" Foreground="#c084fc"/>
                    </StackPanel>
                    <TextBlock Text="Windows Desktop Spooler Installer v1.0.2" FontSize="11" Foreground="#94a3b8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body Content -->
        <Border Grid.Row="1" Background="#131b2e" CornerRadius="14" Padding="20" BorderBrush="#1e293b" BorderThickness="1">
            <StackPanel x:Name="SetupPanel" VerticalAlignment="Center">
                <TextBlock Text="Welcome to AnishNova Print Agent Installation" FontSize="14" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,8"/>
                <TextBlock Text="This setup will install the native Windows Desktop Print Spooler on your computer to connect your physical printers directly to customer mobile orders." 
                           FontSize="12" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="18"/>

                <TextBlock Text="Installation Directory:" FontSize="11" FontWeight="Bold" Foreground="#cbd5e1" Margin="0,0,0,4"/>
                <TextBox x:Name="InstallDirBox" Background="#0b0f19" Foreground="#ffffff" BorderBrush="#334155" Padding="8,6" FontSize="11" Margin="0,0,0,14" IsReadOnly="True"/>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="CreateShortcutCheck" Content="Create Start Menu Shortcut" IsChecked="True" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,6"/>
                    <CheckBox x:Name="LaunchAfterCheck" Content="Launch AnishNova Print Agent immediately after setup" IsChecked="True" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AutoStartCheck" Content="Start automatically with Windows (Recommended)" IsChecked="True" Foreground="#cbd5e1" FontSize="11"/>
                </StackPanel>

                <!-- Progress Bar (hidden initially) -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock x:Name="ProgressStatusText" Text="Installing files..." FontSize="12" Foreground="#c084fc" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="InstallProgressBar" Height="8" Background="#0b0f19" Foreground="#7c3aed" Value="0" Maximum="100"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusInfoText" Text="Ready to install • No admin rights required" FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelBtn" Content="Cancel" Width="80" Height="36" Background="#1e293b" Foreground="#94a3b8" FontWeight="SemiBold" Click="CancelBtn_Click" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="InstallBtn" Content="Install Now" Width="110" Height="36" Background="#7c3aed" Foreground="#ffffff" FontWeight="Bold" Click="InstallBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Attribution -->
        <TextBlock Grid.Row="3" Text="Developed by AnishNova Technologies" FontSize="10" Foreground="#475569" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>
