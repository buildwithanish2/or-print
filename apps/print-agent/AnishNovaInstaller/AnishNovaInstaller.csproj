<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AnishNovaInstaller</RootNamespace>
    <AssemblyName>AnishNovaPrintAgent-Setup</AssemblyName>
    <Version>1.0.3</Version>
    <Description>AnishNova Print Agent Windows Installer</Description>
    <Company>AnishNova Technologies</Company>
    <Product>AnishNova Print Agent Setup</Product>
    <Copyright>Copyright © AnishNova Technologies</Copyright>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AgentPayloadSha256 Condition="'$(AgentPayloadSha256)' == ''">unset</AgentPayloadSha256>
    <AgentPayloadSignatureRequired Condition="'$(AgentPayloadSignatureRequired)' == ''">false</AgentPayloadSignatureRequired>
    <InstallerSignatureRequired Condition="'$(InstallerSignatureRequired)' == ''">false</InstallerSignatureRequired>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AgentPayloadSha256" Value="$(AgentPayloadSha256)" />
    <AssemblyMetadata Include="AgentPayloadSignatureRequired" Value="$(AgentPayloadSignatureRequired)" />
    <AssemblyMetadata Include="InstallerSignatureRequired" Value="$(InstallerSignatureRequired)" />
    <Compile Include="..\PrintQRAgent\Services\AuthenticodeVerifier.cs" Link="Services\AuthenticodeVerifier.cs" />
    <Resource Include="assets\app.ico" />
    <EmbeddedResource Include="assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\PrintQRAgent\bin\Release\net8.0-windows\win-x64\publish\PrintQRAgent.exe" LogicalName="PrintQRAgent.exe" />
  </ItemGroup>

</Project>
