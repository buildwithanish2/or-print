# Prisma database. The schema currently uses SQLite.
DATABASE_URL="file:./dev.db"

# Authentication: use separate random values (at least 32 characters in production).
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"

# Local document storage and retention
UPLOAD_DIR="./uploads"
COLLEGE_EVIDENCE_DIR="./private-college-evidence"
FILE_RETENTION_HOURS=24

# Platform merchant credentials for SaaS subscription checkout only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay platform webhook secret (subscription payment capture events).
RAZORPAY_WEBHOOK_SECRET=""
# Required only when shop merchant credentials are saved in the dashboard.
# Generate a unique 32-byte key and encode as 64 hexadecimal characters.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=""
# Stable production HMAC key for one-way matching of college ID numbers.
COLLEGE_ID_HASH_SECRET=""

# Optional email notifications
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# API and browser origins/links
PORT=5000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"
PUBLIC_API_URL="http://localhost:5000"
CUSTOMER_PORTAL_URL="http://localhost:5173"
SHOP_PORTAL_URL="http://localhost:5174"
ADMIN_PORTAL_URL="http://localhost:5175"

# Vite values are embedded into portal bundles at image build time.
# Set these to the public HTTPS origins before a production Docker build.
VITE_API_URL="http://localhost:5000/api"
VITE_SOCKET_URL="http://localhost:5000"
VITE_CUSTOMER_URL="http://localhost:5173"
VITE_SHOP_URL="http://localhost:5174"

NODE_ENV="development"
